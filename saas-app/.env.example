NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://localhost:27017/saas
# Gere uma chave forte com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=substitua_por_uma_chave_aleatoria_com_no_minimo_32_caracteres
ALLOW_PUBLIC_MULTI_REGISTER=false
ALLOW_DIRECT_PLAN_CHANGE=false
# Store do rate limiter: 'mongodb' (compartilhado entre múltiplas instâncias) ou 'memory'
RATE_LIMIT_STORE=mongodb
CORS_ORIGIN=*
# Configure TRUST_PROXY=1 apenas quando atrás de proxy reverso confiável (Nginx, Cloudflare, etc.)
TRUST_PROXY=
