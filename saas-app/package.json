{
  "name": "saas-app",
  "version": "1.0.0",
  "description": "API SaaS Multitenant com controle de planos, RBAC e isolamento por tenant",
  "main": "server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "test:standalone": "node --test tests/integration/tenantDeletionStandalone.test.js",
    "test:scripts": "node ../test-scripts/run-all.js",
    "test:smoke": "node ../test-scripts/test-smoke.js",
    "test:onboarding": "node ../test-scripts/test-onboarding.js",
    "test:rbac": "node ../test-scripts/test-rbac.js",
    "test:isolation": "node ../test-scripts/test-isolation.js",
    "test:concurrency": "node ../test-scripts/test-concurrency.js",
    "test:ratelimit": "node ../test-scripts/test-rate-limit.js",
    "setup:env": "node scripts/setup-env.js",
    "generate:secret": "node scripts/setup-env.js"
  },
  "keywords": [
    "saas",
    "multitenant",
    "express",
    "mongodb",
    "jwt"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4"
  }
}
